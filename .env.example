# Copie este archivo como .env en la misma carpeta que docker-compose.yml.
# NUNCA suba .env al repositorio: contiene secretos.
#
# La clave de Gemini se obtiene en https://aistudio.google.com/app/apikey
# El navegador nunca la recibe: solo la usa el proxy /api/gemini del servidor.
# Ejemplo: GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Servicio Node del proxy de Gemini (Docker lo inicia en 127.0.0.1:3000).
# ---------------------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Conexión local a MariaDB (para ejecutar `npm run db-api` en el equipo).
# Esta instancia usa el puerto 3307 para no tocar MySQL80 (puerto 3306).
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=ica_app
DB_PASSWORD=IcaApp2026!
DB_NAME=ica_equidos

# El servicio de base de datos escucha en 127.0.0.1:3001 (solo Nginx lo usa
# dentro de Docker; en local también sirve la SPA en http://127.0.0.1:3001).
DB_API_HOST=127.0.0.1
DB_API_PORT=3001

# ---------------------------------------------------------------------------
# Docker: por defecto levanta su propia MariaDB en el servicio `db`.
# Para usar la MariaDB ya instalada en Windows, descomente y ajuste:
#   DB_HOST_DOCKER=host.docker.internal
#   DB_PORT_DOCKER=3307
# En ese caso el contenedor `db` sigue arrancando, pero no se utiliza.
# ---------------------------------------------------------------------------
# DB_HOST_DOCKER=host.docker.internal
# DB_PORT_DOCKER=3307
# DB_ROOT_PASSWORD=IcaEquidos2026!
